# Copy to .env and fill in real values. Never commit .env.

# Encrypts DVR/camera credentials (required)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signs login sessions, at least 32 characters (required)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Session length: without "Remember me" (hours) and with it (days)
SESSION_HOURS=8
REMEMBER_ME_DAYS=7

# Set to true when VIGIL is served over HTTPS
COOKIE_SECURE=false

# Browser origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed sign-ins allowed per email / per IP before a temporary lockout
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

# Password reset by email. Leave SMTP_HOST empty to disable it.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VIGIL_WA_RECIPIENTS=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# ---- Message mode ------------------------------------------------------------------------------------------
VIGIL_WA_USE_TEMPLATES=0             # 0 = free-form video + caption (only inside the 24h window; fine for testing)
                                     # 1 = approved template with video header (PRODUCTION, works outside the window)
VIGIL_WA_FALLBACK_TO_TEMPLATE=1      # free-form rejected with error 131047 -> resend as template (synchronous errors only)
VIGIL_WA_ALERT_TEMPLATE=vigil_violation_alert   # name of your approved template (body: see formatter.TEMPLATE_BODY)
VIGIL_WA_TEMPLATE_LANG=en            # must match the language the template was approved in
WHATSAPP_GRAPH_VERSION=v25.0         # Graph API version; check Meta's changelog occasionally

# ---- Clips & storage (all optional, defaults shown) --------------------------------------------------------
VIGIL_CLIPS_DIR=clips                # clips must live below this folder
VIGIL_CLIP_BASE_DIR=.                # JSON clip_path is resolved against this (clips/CAM01/x.mp4 -> ./clips/CAM01/x.mp4)
VIGIL_ENFORCE_CLIP_NAME_MATCH=1      # file name must carry the event number: event001.mp4 <-> EVT001
VIGIL_CHECK_CODECS=1                 # ffprobe check: H.264 video + AAC audio (skipped if ffprobe is not installed)
VIGIL_ALERT_DB=vigil_alert_outbox.db # SQLite outbox: duplicates, retry queue, rejected payloads
VIGIL_LOCAL_TZ=Asia/Kolkata          # used to display timezone-aware timestamps

# ---- Reliability / logging (optional) ----------------------------------------------------------------------
VIGIL_MAX_ATTEMPTS=5                 # automatic attempts per alert before it is parked as DEAD (retry --force)
VIGIL_HTTP_TIMEOUT=120               # seconds; video uploads need generous timeouts
VIGIL_LOG_FILE=                      # e.g. vigil_alerts.log (rotating); empty = console only
VIGIL_LOG_LEVEL=INFO

# ---- Backblaze B2 polling -------------------------------------------------------------------------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_JSON_PREFIX=alerts/z