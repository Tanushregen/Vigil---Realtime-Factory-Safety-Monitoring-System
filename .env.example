# Copy to .env and fill in real values. Never commit .env.

# Encrypts DVR/camera credentials (required)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signs login sessions, at least 32 characters (required)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Session length: without "Remember me" (hours) and with it (days)
SESSION_HOURS=8
REMEMBER_ME_DAYS=7

# Set to true when VIGIL is served over HTTPS
COOKIE_SECURE=false

# Browser origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed sign-ins allowed per email / per IP before a temporary lockout
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

# Password reset by email. Leave SMTP_HOST empty to disable it.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Violation detection (Meta vision model). A Muse key needs the two lines below;
# without them the default api.llama.com rejects it with 401.
META_API_KEY=
META_API_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Backblaze B2 storage for recordings and violation clips
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT_URL=

# Violation clips: draw the tracked boxes on them (1 = on, 0 = off) and, if the
# boxes look early or late on moving people, shift them by this many seconds
CLIP_ANNOTATE=1
CLIP_BOX_OFFSET=0

# Optional: SAM 2.1 cuts each person out so the cloud model judges one lit person
# on a dimmed background. Off by default; the weights download on first use.
DETECTOR_SEGMENT=0

# Scene log (who is in each zone, for how long, PPE, gate state). Zones are drawn
# on a camera's page. The PPE items asked about, comma separated; SCENE_LOG=0 turns it off
SCENE_LOG=1
SCENE_PPE=helmet,vest

# Model cost shown on the Metrics page (USD per million tokens; leave 0 to hide cost)
META_PRICE_IN_PER_M=0
META_PRICE_OUT_PER_M=0

# WhatsApp alerts and daily report (WhatsApp Cloud API). Leave the token and number id empty to keep it off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VIGIL_WA_RECIPIENTS=            # optional: add and remove numbers on Settings > Notifications instead; a list saved there wins. Digits with country code, comma separated, e.g. 919876543210
VIGIL_WA_USE_TEMPLATES=0        # 1 = always use the approved template (needed outside the 24 h window)
VIGIL_WA_ALERT_TEMPLATE=vigil_violation_alert   # video-header template, see backend/app/alerts/formatter.py
VIGIL_WA_REPORT_TEMPLATE=       # optional 1-parameter template for the daily report
VIGIL_WA_BUSINESS_NUMBER=       # optional: the number people send "hi" to, shown on Settings > Notifications. Left empty, it is read from Meta
VIGIL_LOCAL_TZ=Asia/Kolkata      # factory local time: rule schedules ("10pm to 5am") and the report use it
VIGIL_REPORT_HOUR=18            # local hour the daily report goes out; "off" disables it

# Borderline check: an alert the model was only moderately sure about is re-judged on a short clip first
DETECTOR_VERIFY=1
DETECTOR_VERIFY_BELOW=85        # confidence under this is "borderline"
DETECTOR_VERIFY_FRAMES=6        # frames taken from the clip
DETECTOR_VERIFY_PRE=2           # seconds before / after the moment
DETECTOR_VERIFY_POST=2
DETECTOR_VERIFY_FAIL_OPEN=1     # 1 = if the check cannot run, raise the alert anyway (marked unverified)

# Scene alerts: raised from the scene log (a person in a zone without PPE, a blocked gate or exit, overstay)
SCENE_ALERTS=1
SCENE_ALERT_CONFIRM=2           # readings in a row before an alert
SCENE_ALERT_GAP=120             # seconds between alerts for the same gate
SCENE_STAY_ALERT_MIN=0          # minutes a person may stay in a zone before an alert (0 = off)

# Optional: a separate key for compiling rules, so it never shares the live scans' rate limit.
# Leave empty to use the META_* values above. URL and model default to META_API_URL / META_MODEL.
COMPILER_API_KEY=
COMPILER_API_URL=
COMPILER_MODEL=

# Person detector. The default yolo11n-pose misses small / far / partly hidden people.
# yolo11m-pose at 960 px found them in tests (download it into backend/models/ first):
#   curl -L -o backend/models/yolo11m-pose.pt https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11m-pose.pt
# DETECTOR_POSE_MODEL=backend/models/yolo11m-pose.pt
# DETECTOR_IMGSZ=960

# WhatsApp delivery / read receipts (optional). Meta calls https://<your-domain>/api/whatsapp/webhook
# META_WEBHOOK_VERIFY_TOKEN: a long random string YOU choose; paste the same value in Meta's "Verify token" box
# META_APP_SECRET: Meta app dashboard > App settings > Basic > App secret. Meta only accepts an HTTPS callback.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Zone entry alerts: a person staying in a marked work area raises a scene alert with a clip
# (zone shaded, person boxed), playable from the Scene Log and listed under Alerts.
# Each zone also has its own "alert on entry" switch in the zone editor.
SCENE_ZONE_ALERTS=1
SCENE_ENTRY_SECONDS=3           # seconds in the zone before the alert
SCENE_ENTRY_GAP=60              # seconds between entry alerts for the same zone

# Storage: keep to events and short clips. 0 = keep forever (nothing is deleted). These can also be
# changed on the Settings page (Storage tab), which then wins over the values here.
CLIP_RETENTION_DAYS=0
RECORDING_RETENTION_DAYS=0
RECORDING_ENABLED=1
