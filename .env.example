# Copy to .env and fill in real values. Never commit .env.

# Encrypts DVR/camera credentials (required)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Signs login sessions, at least 32 characters (required)
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Session length: without "Remember me" (hours) and with it (days)
SESSION_HOURS=8
REMEMBER_ME_DAYS=7

# Set to true when VIGIL is served over HTTPS
COOKIE_SECURE=false

# Browser origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Failed sign-ins allowed per email / per IP before a temporary lockout
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

# Password reset by email. Leave SMTP_HOST empty to disable it.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
